# ── Core ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://pedia:pedia_dev_password@localhost:5432/pedia?schema=public

# ── JWT (OAuth 2.1 access/refresh) ───────────────────
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ── Field-level encryption (AES-256-GCM, 32-byte key) ─
FIELD_ENCRYPTION_KEY=dev_32byte_key_dev_32byte_key_xx

# ── WebAuthn / Passkeys ──────────────────────────────
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Pedia
WEBAUTHN_ORIGIN=http://localhost:3000

# ── Apple Sign-In ────────────────────────────────────
APPLE_CLIENT_ID=com.pedia.app
APPLE_ISSUER=https://appleid.apple.com

# ── Google Sign-In ───────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Stripe Connect ───────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PLATFORM_FEE_BPS=2000

# ── AWS S3 ───────────────────────────────────────────
AWS_REGION=eu-west-1
S3_BUCKET=pedia-clinical-files
S3_KMS_KEY_ID=alias/pedia-files
